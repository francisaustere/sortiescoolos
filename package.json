{
  "name": "sorties-cool-os",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -p ./tsconfig.app.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -p ./tsconfig.app.json --noEmit && tsc -p ./tsconfig.node.json --noEmit",
    "crawl": "tsx --tsconfig tsconfig.node.json crawler/index.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "vue": "3.5.44",
    "vue-i18n": "11.4.18"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.4",
    "@types/node": "22.20.5",
    "@vitejs/plugin-vue": "6.0.10",
    "cheerio": "1.2.0",
    "fast-xml-parser": "5.12.0",
    "tailwindcss": "4.3.4",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.1.0",
    "vue-tsc": "3.3.14",
    "zod": "4.6.7"
  }
}
